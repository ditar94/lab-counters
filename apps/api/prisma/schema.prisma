// Prisma schema for Lab Counters
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Organizations & Sites (Multi-tenancy)
// ============================================

enum OrgStatus {
  active
  inactive
  archived
}

model Organization {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  status     OrgStatus @default(active)
  settings   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  sites          Site[]
  users          User[]
  countRecords   ManualCountRecord[]
  monthlyReviews MonthlyReview[]
  auditEvents    AuditEvent[]
  methodConfigs  OrgMethodConfig[]

  @@map("organizations")
}

enum SiteStatus {
  active
  inactive
  archived
}

model Site {
  id         String     @id @default(uuid())
  orgId      String     @map("org_id")
  name       String
  location   String     @default("")
  status     SiteStatus @default(active)
  settings   Json       @default("{}")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  archivedAt DateTime?  @map("archived_at")

  organization   Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users          User[]         // Users with this as their current site
  userSites      UserSite[]     // All users assigned to this site
  countRecords   ManualCountRecord[]
  monthlyReviews MonthlyReview[]

  @@map("sites")
}

// ============================================
// Users
// ============================================

enum UserRole {
  superadmin
  admin
  supervisor
  technologist
  readonly
}

enum UserStatus {
  active
  inactive
  pending
  archived
}

model User {
  id            String     @id @default(uuid())
  cognitoId     String     @unique @map("cognito_id")
  username      String?    @unique // Cognito username for login
  email         String
  name          String
  orgId         String     @map("org_id")
  siteId        String?    @map("site_id") // Current active site
  role          UserRole   @default(technologist)
  status        UserStatus @default(pending)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  archivedAt    DateTime?  @map("archived_at")

  organization     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site             Site?         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sites            UserSite[]    // All sites user can access
  performedRecords ManualCountRecord[] @relation("PerformedBy")
  verifiedRecords  ManualCountRecord[] @relation("VerifiedBy")
  monthlyReviews   MonthlyReview[]
  auditEvents      AuditEvent[]

  @@unique([orgId, email])
  @@map("users")
}

// Join table for many-to-many User <-> Site relationship
model UserSite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  siteId    String   @map("site_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@map("user_sites")
}

// ============================================
// Count Records
// ============================================

enum CountRecordType {
  hemocytometer
  fetal
  retic
  parasite
}

enum RecordStatus {
  draft
  pending_verification
  verified
  corrected
}

model ManualCountRecord {
  id              String          @id @default(uuid())
  orgId           String          @map("org_id")
  siteId          String          @map("site_id")
  type            CountRecordType
  specimenId      String          @map("specimen_id")
  fluidType       String          @map("fluid_type")
  dilution        Float           @default(1)
  squaresCounted  Float           @default(1) @map("squares_counted")
  isQC            Boolean         @default(false) @map("is_qc") // QC samples auto-verify
  status          RecordStatus    @default(draft)
  rawTallies      Json            @map("raw_tallies")
  calculations    Json
  methodVersion   String          @default("1.0.0") @map("method_version") // Version of calculation method used
  paramsSnapshot  Json?           @map("params_snapshot") // Snapshot of method params at count time
  performedById   String          @map("performed_by_id")
  performedAt     DateTime        @default(now()) @map("performed_at")
  performerAttestation String?    @map("performer_attestation") // Attestation statement from performer
  performerAttestedAt DateTime?   @map("performer_attested_at")
  verifiedById    String?         @map("verified_by_id")
  verifiedAt      DateTime?       @map("verified_at")
  verifierAttestation String?     @map("verifier_attestation") // Attestation statement from verifier
  version         Int             @default(1)
  parentRecordId  String?         @map("parent_record_id")
  correctionReason String?        @map("correction_reason")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  performedBy  User             @relation("PerformedBy", fields: [performedById], references: [id])
  verifiedBy   User?            @relation("VerifiedBy", fields: [verifiedById], references: [id])
  parentRecord ManualCountRecord? @relation("RecordVersions", fields: [parentRecordId], references: [id])
  versions     ManualCountRecord[] @relation("RecordVersions")

  @@index([orgId, siteId, status, createdAt])
  @@index([orgId, siteId])
  @@index([specimenId])
  @@index([status])
  @@index([createdAt])
  @@map("count_records")
}

// ============================================
// Monthly Review (CAP Compliance)
// ============================================

model MonthlyReview {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  siteId       String   @map("site_id")
  year         Int
  month        Int      // 1-12
  reviewedById String   @map("reviewed_by_id")
  reviewedAt   DateTime @default(now()) @map("reviewed_at")
  notes        String?
  stats        Json     // Snapshot of record counts at time of review
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reviewedBy   User         @relation(fields: [reviewedById], references: [id])

  @@unique([orgId, siteId, year, month])
  @@index([orgId, siteId])
  @@map("monthly_reviews")
}

// ============================================
// Audit Log
// ============================================

model AuditEvent {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  actorUserId String   @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorUserId], references: [id])

  @@index([orgId, entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// Method Configuration (Per-Org Counter Settings)
// ============================================

model OrgMethodConfig {
  id          String          @id @default(uuid())
  orgId       String          @map("org_id")
  counterType CountRecordType @map("counter_type")
  config      Json            // Counter-specific configuration parameters
  version     Int             @default(1) // Incremented on each update for audit trail
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, counterType])
  @@index([orgId])
  @@map("org_method_configs")
}
